<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- Pin transitive package to a patched version (clears NU1903 advisory). -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticLayer.Application\SemanticLayer.Application.csproj" />
    <ProjectReference Include="..\SemanticLayer.Infrastructure\SemanticLayer.Infrastructure.csproj" />
    <ProjectReference Include="..\SemanticLayer.Domain\SemanticLayer.Domain.csproj" />
  </ItemGroup>

</Project>
